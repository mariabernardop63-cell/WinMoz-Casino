{
  "buildCommand": "cd ../../ && pnpm run typecheck:libs && pnpm --filter @workspace/winmoz run build && pnpm --filter @workspace/api-server run build && mkdir -p artifacts/api-server/public && cp -r artifacts/winmoz/dist/public/. artifacts/api-server/public/",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/api(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
